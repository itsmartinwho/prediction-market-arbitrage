# Prediction Market Arbitrage - Environment Variables

# App
DEBUG=false

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./arb.db

# Polymarket (not needed for detection-only mode)
POLYMARKET_PRIVATE_KEY=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Arbitrage Detection
MIN_PROFIT_THRESHOLD=0.025
SCAN_INTERVAL_SECONDS=5

# Risk Management (conservative for paper trading)
MAX_POSITION_PER_MARKET=50
MAX_GLOBAL_EXPOSURE=500
MAX_DAILY_LOSS=50
ENABLE_AUTO_EXECUTE=false
