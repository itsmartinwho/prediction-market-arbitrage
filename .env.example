# Backend settings. Copy this file to backend/.env (or set them in your
# host's environment). Every value is optional: with none set, the backend
# scans, serves its API and prints alerts to the console.

# How scans run: on_request (no loop; a request scans when the cached scan is
# older than CACHE_TTL_SECONDS), continuous (a loop scans and alerts), or auto
# (on_request on Vercel, continuous anywhere else).
SCANNER_MODE=auto

# How many of the most liquid two-outcome markets one scan reads.
# Leave unset for 200 on request and 1000 in the continuous loop.
# SCAN_MARKET_LIMIT=200

# How long a scan, a market list or a trade list is reused, in seconds.
# On Vercel it is also the CDN's s-maxage.
CACHE_TTL_SECONDS=30

# Smallest net edge to report, as a fraction of what the two legs cost.
# 0.01 is 1%.
MIN_PROFIT_THRESHOLD=0.01

# Continuous mode: seconds to wait after each scan.
SCAN_INTERVAL_SECONDS=5

# Telegram alerts, continuous mode only. Set both to also send each alert to
# a chat. Make a bot with @BotFather for the token; the chat id is your chat
# with it. Leave them empty (not a placeholder) to keep Telegram off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Polymarket's public, read-only APIs. Change only to point at a mirror.
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Frontend settings are not read here. Outside Vercel, `next dev` and
# `next start` send /api/* to BACKEND_URL (default http://localhost:8000):
#
# BACKEND_URL=http://localhost:8000
