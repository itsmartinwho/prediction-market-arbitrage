# Backend settings. Copy this file to backend/.env.
# Every value is optional. With none set, the backend scans, serves its API
# and prints alerts to the console.

# Telegram alerts. Set both to also send each alert to a chat.
# Make a bot with @BotFather for the token; the chat id is your chat with it.
# Leave them empty (not a placeholder) to keep Telegram off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Smallest net edge to alert on, as a fraction of what the two legs cost.
# 0.01 is 1%.
MIN_PROFIT_THRESHOLD=0.01

# Seconds to wait between scans. A scan itself takes minutes.
SCAN_INTERVAL_SECONDS=5

# Polymarket's public, read-only APIs. Change only to point at a mirror.
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com

# Frontend settings are not read here. Put these two in frontend/.env.local
# (or your host's environment) when the backend is not on localhost:8000.
# They are read when Next.js starts or builds.
#
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
